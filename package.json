{
  "name": "sanity-plugin-icon-picker-v2",
  "version": "1.0.3",
  "description": "An Icon Picker plugin for Sanity",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "plugin",
    "icon",
    "custom input",
    "sanity field"
  ],
  "homepage": "https://github.com/exaland/sanity-plugin-icon-picker-v2#readme",
  "bugs": {
    "url": "https://github.com/exaland/sanity-plugin-icon-picker-v2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exaland/sanity-plugin-icon-picker-v2.git"
  },
  "license": "MIT",
  "author": "Alexandre Magnier - Exaland Concept <exaland@gmail.com>",
  "contributors": [
    "Christopher Afbjur"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.esm.d.ts",
  "type": "module",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "run-s clean && plugin-kit verify-package --silent && pkg-utils build --strict && pkg-utils --strict",
    "check-types": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
    "format": "prettier --write --cache --ignore-unknown .",
    "format:check": "prettier --check .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prepare": "husky install",
    "prepublishOnly": "run-s build",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.1.13",
    "@tanstack/react-virtual": "^3.13.21",
    "decamelize": "6.0.1",
    "framework7-icons": "^5.0.5",
    "react-icons": "^5.6.0",
    "react-window": "^2.2.7",
    "sanity": "^5.14.1",
    "styled-components": "^6.3.11"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@sanity/pkg-utils": "^10.4.8",
    "@sanity/plugin-kit": "^4.0.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.10",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "19.2.4",
    "sanity": "^5.14.1"
  },
  "engines": {
    "node": ">=24"
  },
  "sanityExchangeUrl": "https://www.sanity.io/plugins/icon-picker-v2",
  "sanityPlugin": {
    "verifyPackage": {
      "scripts": false,
      "nodeEngine": false,
      "eslintImports": false
    }
  }
}
